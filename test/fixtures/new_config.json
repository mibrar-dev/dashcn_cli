{
  "defaultNamespace": "dashcn",
  "registries": {
    "dashcn": {
      "registryMode": "remote",
      "registryUrl": "https://example.com/registry",
      "installPath": "lib/ui/dashcn",
      "sharedPath": "lib/ui/dashcn/shared",
      "includeFiles": ["meta"],
      "excludeFiles": ["preview"],
      "enabled": true
